# Phase-2 PDM clock/control candidate, PYNQ-Z2 Pmod B.
# The four inputs are pinned but have no capture endpoints until phase 3.
set_property PACKAGE_PIN W14 [get_ports pdm_clk_o]
set_property IOSTANDARD LVCMOS33 [get_ports pdm_clk_o]

set_property PACKAGE_PIN Y14 [get_ports {pdm_data_i[0]}]
set_property PACKAGE_PIN T11 [get_ports {pdm_data_i[1]}]
set_property PACKAGE_PIN T10 [get_ports {pdm_data_i[2]}]
set_property PACKAGE_PIN V16 [get_ports {pdm_data_i[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {pdm_data_i[*]}]

# 24 MHz is generated by the MMCM inside the control module. The external PDM
# clock changes state every five 24 MHz edges: one complete period per ten.
# Do not use this output as an internal logic clock.
create_generated_clock -name pdm_clk_o \
    -source [get_pins -hier -filter {NAME =~ *clock24_bufg_i/O}] \
    -divide_by 10 [get_ports pdm_clk_o]

# These asynchronous level/reset crossings are synchronized in RTL. Exempt
# only the first-stage D pins and asynchronous reset pins from synchronous
# timing; the second stages and all microphone DATA paths remain unwaived.
set_false_path -to [get_pins -hier -filter {NAME =~ */enable_meta_reg/D}]
set_false_path -to [get_pins -hier -filter {NAME =~ */locked_meta_reg/D}]
set_false_path -to [get_pins -hier -filter {NAME =~ */ready_meta_reg/D}]
set_false_path -to [get_pins -hier -filter {NAME =~ */reset24_pipe_reg*/CLR}]

# No input delay is declared yet: phase 2 has no DATA capture endpoint. Do not
# waive these paths with false-path exceptions; define the external timing in
# phase 3 when the sampler is integrated.
